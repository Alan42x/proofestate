@startuml

scale 3

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 4

skinparam nodesep 100
skinparam ranksep 100

skinparam ArrowColor #374151
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #111827
skinparam ArrowFontSize 12

skinparam StateBorderColor #334155
skinparam StateBackgroundColor #FFFFFF
skinparam StateFontColor #111827
skinparam StateFontSize 14
skinparam StateFontStyle bold

skinparam StateAttributeFontSize 12
skinparam StateAttributeFontStyle plain
skinparam StateAttributeFontColor #475569

skinparam StateStartColor #111827
skinparam StateEndColor #111827

skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #111827
  FontSize 14
  FontStyle bold
  AttributeFontSize 12
  AttributeFontStyle plain
  AttributeFontColor #475569
  RoundCorner 4
}

top to bottom direction
state Requested
Requested : Lock: Held
state Approved
Approved : Lock: Held
state Repaid
Repaid : Lock: Released
state Rejected
Rejected : Lock: Released
state Cancelled
Cancelled : Lock: Released
state Final <<end>>

Rejected -[hidden]right-> Approved
Approved -[hidden]right-> Cancelled

[*] -down-> Requested : requestLoan()\n[recorded owner; nonzero ID;\nnonzero Cp; no active loan]\n/ hold lock
Requested -down-> Approved : approveLoan()\n[officer; verified and\nmatching compliance]
Approved -down-> Repaid : repay()\n[borrower]\n/ release lock
Requested -down-> Rejected : rejectLoan() [officer]\nor approveLoan()\n[officer; verification or\ncompliance fails]\n/ release lock
Requested -down-> Cancelled : cancelLoan()\n[borrower]\n/ release lock
Repaid -down-> Final
Rejected -down[norank]-> Final
Cancelled -down[norank]-> Final
@enduml
