%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "fontSize": "16px", "primaryColor": "#f8fafc", "primaryTextColor": "#111827", "primaryBorderColor": "#64748b", "lineColor": "#475569", "clusterBkg": "#f8fafc", "clusterBorder": "#94a3b8", "edgeLabelBackground": "#ffffff"}}}%%
flowchart LR
  subgraph Verify["1. Property Verification"]
    direction TB
    Start["Select property"] --> OwnerCheck{"Wallet owns property?"}
    OwnerCheck -- No --> OwnerBlocked["Loan request blocked"]
    OwnerCheck -- Yes --> Registry["Oracle reads mock registry"]
    Registry --> RegistryRules{"Registry rules pass?"}
    RegistryRules -- No --> VerificationFail["Verification failed"]
    RegistryRules -- Yes --> Verified["setVerified"]
  end

  subgraph Proof["2. ZK Compliance"]
    direction TB
    Principal["Enter principal"] --> Ltv{"80% LTV rule passes?"}
    Ltv -- No --> NonCompliant["No compliance proof written"]
    Ltv -- Yes --> ProofGen["Generate Groth16 proof"]
    ProofGen --> VerifyProof["verifyProofAndSetCompliance"]
  end

  subgraph Loan["3. Loan Lifecycle"]
    direction TB
    Request["requestLoan"] --> Lock["Active loan lock"]
    Lock --> Officer{"Loan officer decision"}
    Officer -- Invalid --> Reject["Reject and release lock"]
    Officer -- Valid --> Approve["Approve loan"]
    Approve --> Repay["Borrower repay"]
    Repay --> Repaid["Repaid and lock released"]
    Request --> Cancel["Borrower cancel"]
    Cancel --> Cancelled["Cancelled and lock released"]
  end

  Verified --> Principal
  VerifyProof --> Request

  classDef process fill:#ffffff,stroke:#334155,stroke-width:1.2px,color:#111827;
  classDef decision fill:#eff6ff,stroke:#2563eb,stroke-width:1.2px,color:#111827;
  classDef terminal fill:#f1f5f9,stroke:#64748b,stroke-width:1.2px,color:#111827;
  class Start,Registry,Verified,Principal,ProofGen,VerifyProof,Request,Lock,Approve,Repay process;
  class OwnerCheck,RegistryRules,Ltv,Officer decision;
  class OwnerBlocked,VerificationFail,NonCompliant,Reject,Repaid,Cancel,Cancelled terminal;
