@startuml

scale 2

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #475569
skinparam ArrowThickness 1.2
skinparam ActivityBorderColor #334155
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #2563eb
skinparam ActivityDiamondBackgroundColor #eff6ff
skinparam ActivityStartColor #111827
skinparam ActivityEndColor #111827
skinparam PartitionBorderColor #94a3b8
skinparam PartitionBackgroundColor #f8fafc
skinparam PartitionFontColor #111827

start

partition "1. Property verification (write-enabled API)" {
  :Select property and read mock registry;
  :Evaluate registry rules;
  :setVerified(result)\nRecord owner and clear prior compliance;
  if (Registry rules pass?) then (yes)
  else (no)
    :Verification recorded as false;
    stop
  endif
}

partition "2. ZK compliance" {
  :Enter principal and evaluate LTV;
  if (Inputs satisfy ranges and LTV?) then (yes)
    :Generate Groth16 proof;
    :Submit verifyProofAndSetCompliance();
    if (Contract bindings and proof valid?) then (yes)
      :Record compliance for principal commitment;
    else (no)
      :Revert transaction\nNo compliance state change;
      stop
    endif
  else (no)
    :Compliance request fails;
    stop
  endif
}

partition "3. Loan processing" {
  :Borrower submits requestLoan();
  if (Recorded owner, nonzero principal commitment,\nnonempty property ID and no active loan?) then (yes)
    :Create Requested loan and hold property lock;
  else (no)
    :Revert request\nNo loan or lock created;
    stop
  endif

  if (Borrower cancels?) then (yes)
    :cancelLoan()\nSet Cancelled and release lock;
    stop
  else (no)
    :Loan officer reviews request;
    if (Officer selects approval?) then (yes)
      :approveLoan();
      if (Property currently verified and compliance\nmatches the requested principal commitment?) then (yes)
        :Set Approved and retain lock;
        :Borrower calls repay()\nSet Repaid and release lock;
        note right
          Repayment records a state change;
          no asset settlement is implemented.
        end note
        stop
      else (no)
        :Set Rejected and release lock;
        stop
      endif
    else (no)
      :rejectLoan()\nSet Rejected and release lock;
      stop
    endif
  endif
}

@enduml
