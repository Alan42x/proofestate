%%{init: {"theme": "base", "sequence": {"mirrorActors": false, "actorMargin": 22, "width": 135, "height": 42, "messageMargin": 14, "boxMargin": 8, "boxTextMargin": 5, "noteMargin": 6, "wrap": false, "actorFontSize": 18, "messageFontSize": 18, "noteFontSize": 17, "rightAngles": true}, "themeVariables": {"fontFamily": "Arial", "fontSize": "18px", "primaryColor": "#ffffff", "primaryTextColor": "#111827", "primaryBorderColor": "#64748b", "lineColor": "#475569", "actorBkg": "#ffffff", "actorBorder": "#334155", "actorTextColor": "#111827", "activationBkgColor": "#e2e8f0", "activationBorderColor": "#475569", "sequenceNumberColor": "#111827", "noteBkgColor": "#f8fafc", "noteBorderColor": "#94a3b8", "noteTextColor": "#111827"}}}%%
sequenceDiagram
  participant DApp as DApp / wallet
  participant Oracle as Oracle / prover
  box On-chain contracts
    participant PV
    participant CV
    participant Lending
  end

  DApp->>Oracle: POST /verify<br/>(write=true)
  Oracle->>PV: setVerified(...)
  PV-->>Oracle: Tx receipt
  Oracle-->>DApp: Verification result

  DApp->>Oracle: POST /compliance<br/>(write=true)
  Oracle->>Oracle: Generate proof<br/>and public signals
  Oracle->>CV: verifyProofAndSetCompliance(...)
  CV->>PV: isVerified() and<br/>valuationCommitmentOf()
  PV-->>CV: Verified flag and Cv
  Note over CV: Bind public signals<br/>Verify Groth16 proof
  CV->>PV: setCompliant(...)
  CV-->>Oracle: Tx receipt
  Oracle-->>DApp: Proof and<br/>compliance result

  DApp->>Lending: Borrower: requestLoan(..., Cp)
  Lending->>PV: ownerOf(propertyId)
  PV-->>Lending: Recorded owner
  Lending-->>DApp: LoanRequested (lock held)
  DApp->>Lending: Officer: approveLoan(loanId)
  Lending->>PV: isVerified() and<br/>isCompliantFor(..., Cp)
  PV-->>Lending: Verification / compliance
  Lending-->>DApp: Approval / rejection event
  opt loan approved
    DApp->>Lending: Borrower: repay(loanId)
    Lending-->>DApp: LoanRepaid (lock released)
  end
