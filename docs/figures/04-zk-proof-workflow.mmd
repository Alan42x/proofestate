%%{init: {"theme": "base", "flowchart": {"defaultRenderer": "elk", "curve": "linear", "nodeSpacing": 36, "rankSpacing": 44, "wrappingWidth": 230, "diagramPadding": 16}, "elk": {"mergeEdges": false, "nodePlacementStrategy": "NETWORK_SIMPLEX", "nodePlacementAlignment": "BALANCED"}, "themeVariables": {"fontFamily": "Arial", "fontSize": "17px", "primaryColor": "#ffffff", "primaryTextColor": "#111827", "primaryBorderColor": "#64748b", "lineColor": "#475569", "clusterBkg": "#f8fafc", "clusterBorder": "#94a3b8", "edgeLabelBackground": "#ffffff"}}}%%
flowchart TB
  subgraph Preparation["1. Off-chain input preparation"]
    direction LR
    Context["Property context<br/>propertyId / bytes32<br/>application policy t = 8000"]
    Witness["Private circuit witness w<br/>v: valuation; p: principal<br/>sv, sp: corresponding salts"]
    Statement["Public statement x = (k, Cv, Cp, t)<br/>k = propertyId mod r<br/>Cv = H(k, v, sv)<br/>Cp = H(k, p, sp)"]
    Context --> Statement
    Witness --> Statement
  end

  subgraph Proving["2. Off-chain circuit and Groth16 proving"]
    direction LR
    Constraints["Circuit relation<br/>64-bit v, p; 14-bit t<br/>commitment openings<br/>10000p <= tv; 80-bit comparison"]
    Prover["Groth16 prover<br/>WASM witness generation<br/>and circuit-specific proving key"]
    Output["Proof (a, b, c)<br/>and public signals x"]
    Constraints -.->|enforced relation| Prover
    Prover --> Output
  end

  subgraph OnChain["3. On-chain binding, verification and state update"]
    direction LR
    Binding["ComplianceVerifier<br/>Require verified property<br/>Match k, current Cv, submitted Cp<br/>and fixed threshold t = 8000"]
    Verifier["LtvGroth16Verifier<br/>verifyProof(a, b, c, x)"]
    Record["ComplianceVerifier calls<br/>PropertyVerification<br/>.setCompliant(...)<br/>Record compliance, Cp and proof hash"]
    Binding -->|call| Verifier
    Verifier -->|if valid, resume wrapper| Record
  end

  Preparation -->|public x and private w| Proving
  Proving -->|proof and public signals only| OnChain

  classDef publicData fill:#eff6ff,stroke:#2563eb,stroke-width:1.2px,color:#111827;
  classDef privateData fill:#ffffff,stroke:#334155,stroke-width:1.2px,color:#111827;
  classDef process fill:#ffffff,stroke:#475569,stroke-width:1.2px,color:#111827;
  classDef chain fill:#ecfeff,stroke:#0891b2,stroke-width:1.2px,color:#111827;
  class Context,Statement,Output publicData;
  class Witness privateData;
  class Constraints,Prover process;
  class Binding,Verifier,Record chain;
