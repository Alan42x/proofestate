  classDef data fill:#f8fafc,stroke:#64748b,stroke-width:1.2px,color:#111827;
  classDef contract fill:#ecfeff,stroke:#0891b2,stroke-width:1.2px,color:#111827;
  class Wallets actor;
  class DApp app;
  class Oracle,Prover service;
  class Registry data;
  class RoleAdminManager,Lending,PropertyVerification,ComplianceVerifier,LtvGroth16Verifier contract;
