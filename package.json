{
  "name": "proofestate",
  "version": "0.1.0",
  "private": true,
  "description": "Ethereum testnet application for property verification, compliance proof, and lending.",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:oracle": "node --test backend/oracle/*.test.js",
    "test:gas": "REPORT_GAS=true hardhat test",
    "zk:compile": "node scripts/zk-build.mjs compile",
    "zk:setup": "node scripts/zk-build.mjs setup",
    "zk:prove": "node scripts/zk-build.mjs prove",
    "zk:build": "node scripts/zk-build.mjs build",
    "chain:local": "hardhat node",
    "deploy:local": "PROOFESTATE_ENV_FILE=.env.local hardhat run scripts/chain/deploy.js --network localhost",
    "deploy:sepolia": "PROOFESTATE_ENV_FILE=.env.sepolia hardhat run scripts/chain/deploy.js --network sepolia && PROOFESTATE_ENV_FILE=.env.sepolia node scripts/chain/sync-sepolia-env.js",
    "demo:deploy": "PROOFESTATE_ENV_FILE=.env.local hardhat run scripts/chain/deploy.js --network localhost && PROOFESTATE_ENV_FILE=.env.local node scripts/chain/sync-local-env.js",
    "demo:sync": "PROOFESTATE_ENV_FILE=.env.local node scripts/chain/sync-local-env.js",
    "demo:check": "PROOFESTATE_ENV_FILE=.env.local node scripts/local/demo-check.js",
    "demo:ready": "PROOFESTATE_ENV_FILE=.env.local node scripts/local/demo-check.js --strict",
    "demo:flow": "PROOFESTATE_ENV_FILE=.env.local node scripts/local/wallet-flow.js",
    "benchmark:local": "PROOFESTATE_ENV_FILE=.env.local node scripts/local/benchmark.mjs",
    "layout:check": "node scripts/e2e/verify-layout.mjs",
    "e2e": "node scripts/e2e/wallet-gate-smoke.mjs",
    "thesis:check": "node scripts/thesis/audit.mjs",
    "thesis:docx": "python3 scripts/thesis/build-docx.py",
    "thesis:slides": "node scripts/thesis/build-slides.mjs",
    "test:all": "pnpm compile && pnpm test && pnpm test:oracle && pnpm frontend:test && pnpm frontend:build",
    "oracle:list": "node backend/oracle/cli.js list",
    "oracle:verify": "PROOFESTATE_ENV_FILE=.env.local node backend/oracle/cli.js verify",
    "oracle:compliance": "PROOFESTATE_ENV_FILE=.env.local node backend/oracle/cli.js compliance",
    "oracle:e2e": "PROOFESTATE_ENV_FILE=.env.local node backend/oracle/cli.js e2e",
    "oracle:api": "PROOFESTATE_ENV_FILE=.env.local node backend/oracle/server.js",
    "oracle:api:sepolia": "PROOFESTATE_ENV_FILE=.env.sepolia node backend/oracle/server.js",
    "sepolia:sync": "PROOFESTATE_ENV_FILE=.env.sepolia node scripts/chain/sync-sepolia-env.js",
    "sepolia:inspect": "PROOFESTATE_ENV_FILE=.env.sepolia node scripts/chain/inspect-sepolia.js",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:dev:local": "pnpm --dir frontend dev",
    "frontend:dev:sepolia": "pnpm --dir frontend dev --mode sepolia",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:build:local": "pnpm --dir frontend build",
    "frontend:build:sepolia": "pnpm --dir frontend build --mode sepolia",
    "frontend:test": "pnpm --dir frontend test"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "hardhat": "^2.22.19",
    "playwright-core": "^1.60.0",
    "snarkjs": "^0.7.5"
  }
}
