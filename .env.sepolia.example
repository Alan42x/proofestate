# Sepolia RPC and deployment signer
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0x...

# Optional Sepolia role recipients. Defaults to deployer if omitted.
ADMIN_ADDRESS=
ORACLE_ADDRESS=
LOAN_OFFICER_ADDRESS=

# Optional demo shortcut. When set, the oracle treats every mock property as
# owned by this address. Useful for single-wallet Sepolia testing.
PROPERTY_OWNER_OVERRIDE_ADDRESS=

# Sepolia deployed contract addresses. Filled manually from deployments/sepolia.json if needed.
PROPERTY_VERIFICATION_ADDRESS=
COMPLIANCE_VERIFIER_ADDRESS=
LENDING_ADDRESS=
