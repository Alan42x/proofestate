# Oracle API and Sepolia RPC endpoint
VITE_ORACLE_API_URL=http://localhost:8787
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Sepolia role addresses. `pnpm sepolia:sync` fills these values after deployment.
VITE_ADMIN_ADDRESS=
VITE_ORACLE_ADDRESS=
VITE_LOAN_OFFICER_ADDRESS=

# Sepolia deployed contract addresses. `pnpm sepolia:sync` fills these values.
VITE_PROPERTY_VERIFICATION_ADDRESS=
VITE_LTV_GROTH16_VERIFIER_ADDRESS=
VITE_COMPLIANCE_VERIFIER_ADDRESS=
VITE_LENDING_ADDRESS=
VITE_ROLE_ADMIN_MANAGER_ADDRESS=

VITE_DEFAULT_NETWORK=sepolia
