# Sepolia deployment
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0x...

# Optional role recipients. Defaults to deployer if omitted.
ORACLE_ADDRESS=0x...
LOAN_OFFICER_ADDRESS=0x...

# Oracle backend
LOCAL_RPC_URL=http://127.0.0.1:8545
ORACLE_PRIVATE_KEY=0x...
PROPERTY_VERIFICATION_ADDRESS=0x...
COMPLIANCE_VERIFIER_ADDRESS=0x...
LENDING_ADDRESS=0x...
ORACLE_PORT=8787
